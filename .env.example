# Copy this file to .env for local runs, or paste these into Railway's
# "Variables" tab for a deployed bot. Never commit a real .env file.

# From @BotFather on Telegram (see README for steps)
TELEGRAM_BOT_TOKEN=

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave blank while testing; message @userinfobot on Telegram to find your ID.
ALLOWED_CHAT_IDS=

# Optional: IANA timezone name used to decide when "today" rolls over.
BOT_TIMEZONE=Asia/Singapore

# Optional: where the SQLite file is stored.
DB_PATH=expenses.db

# Optional: starting daily target before you run /settarget.
DEFAULT_DAILY_TARGET=100

# Optional: your home currency. All balance/target math happens in this
# currency; expenses logged in other currencies are converted to it.
BASE_CURRENCY=SGD

# Optional: fraction (0-1) of today's available budget that triggers a
# one-time "heads up" nudge once crossed.
BUDGET_ALERT_THRESHOLD=0.9
